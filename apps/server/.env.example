APP_ENV=dev
HTTP_ADDR=:8080
LOG_LEVEL=info
LOG_FORMAT=text

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/starter?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2
AUTO_MIGRATE=true

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Security & HTTP
JWT_SECRET=change-me-to-a-long-random-secret-in-prod
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=168h
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
REQUEST_TIMEOUT=15s
RATE_LIMIT_PER_MIN=120
SHUTDOWN_TIMEOUT=10s

# Storage & Worker
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
MAX_LARGE_UPLOAD_MB=500
IMAGE_MAX_WIDTH=1920
IMAGE_JPEG_QUALITY=80
WORKER_CONCURRENCY=5

# Integration Test (库名必须包含 test)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/starter_test?sslmode=disable
TEST_REDIS_ADDR=localhost:6379
TEST_REDIS_DB=15

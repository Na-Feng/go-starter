{
  "name": "taro-starter",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:weapp": "taro build --type weapp --watch",
    "build:weapp": "taro build --type weapp",
    "gen:api": "openapi-typescript ../server/docs/openapi.yaml -o src/api/schema.d.ts",
    "lint:biome": "biome check .",
    "lint:rules": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm lint:biome && pnpm lint:rules && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.60.0",
    "@tarojs/components": "4.0.7",
    "@tarojs/plugin-framework-react": "4.0.7",
    "@tarojs/react": "4.0.7",
    "@tarojs/runtime": "4.0.7",
    "@tarojs/taro": "4.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@tanstack/eslint-plugin-query": "^5.60.0",
    "@tarojs/cli": "4.0.7",
    "@types/react": "^18.3.12",
    "eslint": "^9.15.0",
    "openapi-typescript": "^7.4.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.5"
  }
}
